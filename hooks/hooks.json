{
  "description": "guard-rails: block commits/pushes to protected branches, destructive file restores, and colliding test runs; agent-bash-guard: restrict sub agents (by agent_type) to read-only Bash and scratchpad/logs/code_reviews writes",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_rails.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_bash_guard.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
